rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // パスワードなしで だれでも よみかき できる ルールです。
    // 「かんたんな なまえで あける」という ようけんに あわせています。
    // URLや Firebase の せっていを しらない ひとには みつかりませんが、
    // ぜったいに 見られたくない ないようは 保存しないでください。
    match /kv/{document} {
      allow read, write: if true;
    }
  }
}
